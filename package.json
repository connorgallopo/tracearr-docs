{
  "name": "tracearr-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind && npm run search:check",
    "search:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-search.mjs",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,mdx}\"",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@next/third-parties": "^16.4.2",
    "@posthog/nextjs-config": "^1.11.3",
    "@scalar/api-reference-react": "^0.9.81",
    "lucide-react": "^1.60.0",
    "next": "^15.5.28",
    "next-themes": "^0.4.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "posthog-js": "^1.438.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.0.0",
    "eslint-config-next": "^15.5.28",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "nextra": {
      "zod": "<4.4.0"
    },
    "nextra-theme-docs": {
      "zod": "<4.4.0"
    }
  }
}
